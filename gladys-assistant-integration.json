{
  "manifest_version": 1,
  "type": "device",
  "name": "ZoneMinder",
  "description": {
    "en": "ZoneMinder monitors: images, alarms, events, modes and forced alarms, from your own server.",
    "fr": "Moniteurs ZoneMinder : images, alarmes, événements, modes et alarmes forcées, depuis votre serveur.",
    "de": "ZoneMinder-Monitore: Bilder, Alarme, Ereignisse, Modi und erzwungene Alarme, vom eigenen Server.",
    "es": "Monitores ZoneMinder: imágenes, alarmas, eventos, modos y alarmas forzadas, desde su servidor."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-zoneminder:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-zoneminder/main/cover.png",
  "categories": ["security"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Your ZoneMinder server",
        "fr": "Votre serveur ZoneMinder",
        "de": "Dein ZoneMinder-Server",
        "es": "Su servidor ZoneMinder"
      },
      "description": {
        "en": "ZoneMinder 1.36 or later, with \"OPT_USE_API\" on. Enter the address of its web page and an account with \"API Enabled\" (Options → Users). Then open the Discovery tab: one device per monitor.",
        "fr": "ZoneMinder 1.36 ou plus récent, avec « OPT_USE_API » activé. Saisissez l'adresse de sa page web et un compte avec « API Enabled » (Options → Users). Ouvrez ensuite l'onglet Découverte : un appareil par moniteur.",
        "de": "ZoneMinder 1.36 oder neuer, mit aktiviertem „OPT_USE_API“. Gib die Adresse seiner Weboberfläche und ein Konto mit „API Enabled“ ein (Options → Users). Öffne dann den Tab „Entdecken“: ein Gerät pro Monitor.",
        "es": "ZoneMinder 1.36 o posterior, con «OPT_USE_API» activado. Introduzca la dirección de su página web y una cuenta con «API Enabled» (Options → Users). Luego abra la pestaña Descubrir: un dispositivo por monitor."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-zoneminder/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide d'installation",
            "de": "Installationsanleitung",
            "es": "Guía de instalación"
          }
        }
      ]
    },
    {
      "key": "url",
      "type": "string",
      "label": {
        "en": "ZoneMinder address",
        "fr": "Adresse de ZoneMinder",
        "de": "ZoneMinder-Adresse",
        "es": "Dirección de ZoneMinder"
      },
      "description": {
        "en": "Without a path, /zm then / are tried. Add https:// or a port if needed.",
        "fr": "Sans chemin, /zm puis / sont essayés. Ajoutez https:// ou un port si besoin.",
        "de": "Ohne Pfad werden /zm und dann / versucht. Füge bei Bedarf https:// oder einen Port hinzu.",
        "es": "Sin ruta, se prueban /zm y luego /. Añada https:// o un puerto si es necesario."
      },
      "placeholder": {
        "en": "e.g. http://192.168.1.20/zm",
        "fr": "ex. http://192.168.1.20/zm",
        "de": "z. B. http://192.168.1.20/zm",
        "es": "p. ej. http://192.168.1.20/zm"
      },
      "required": true,
      "default": ""
    },
    {
      "key": "username",
      "type": "string",
      "label": {
        "en": "User name",
        "fr": "Nom d'utilisateur",
        "de": "Benutzername",
        "es": "Usuario"
      },
      "description": {
        "en": "Leave empty if ZoneMinder has no login (OPT_USE_AUTH off). Changing modes needs \"Monitors: Edit\".",
        "fr": "Laisser vide si ZoneMinder n'a pas de connexion (OPT_USE_AUTH désactivé). Changer les modes demande « Monitors : Edit ».",
        "de": "Leer lassen, wenn ZoneMinder keine Anmeldung hat (OPT_USE_AUTH aus). Modi ändern braucht „Monitors: Edit“.",
        "es": "Déjelo vacío si ZoneMinder no tiene inicio de sesión (OPT_USE_AUTH desactivado). Cambiar modos requiere «Monitors: Edit»."
      },
      "required": false,
      "default": "admin"
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe",
        "de": "Passwort",
        "es": "Contraseña"
      },
      "required": false
    },
    {
      "key": "alarm_interval",
      "type": "select",
      "label": {
        "en": "Alarm check",
        "fr": "Vérification des alarmes",
        "de": "Alarmprüfung",
        "es": "Comprobación de alarmas"
      },
      "description": {
        "en": "How often the alarm state and new events of the monitors added in Gladys are read.",
        "fr": "Fréquence de lecture de l'état d'alarme et des nouveaux événements des moniteurs ajoutés dans Gladys.",
        "de": "Wie oft Alarmzustand und neue Ereignisse der in Gladys hinzugefügten Monitore gelesen werden.",
        "es": "Con qué frecuencia se leen el estado de alarma y los nuevos eventos de los monitores añadidos en Gladys."
      },
      "required": false,
      "default": "5",
      "options": [
        {
          "value": "2",
          "label": {
            "en": "2 seconds",
            "fr": "2 secondes",
            "de": "2 Sekunden",
            "es": "2 segundos"
          }
        },
        {
          "value": "5",
          "label": {
            "en": "5 seconds",
            "fr": "5 secondes",
            "de": "5 Sekunden",
            "es": "5 segundos"
          }
        },
        {
          "value": "10",
          "label": {
            "en": "10 seconds",
            "fr": "10 secondes",
            "de": "10 Sekunden",
            "es": "10 segundos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes",
            "de": "30 Sekunden",
            "es": "30 segundos"
          }
        }
      ]
    },
    {
      "key": "snapshot_interval",
      "type": "select",
      "label": {
        "en": "Image refresh",
        "fr": "Rafraîchissement des images",
        "de": "Bildaktualisierung",
        "es": "Actualización de imágenes"
      },
      "description": {
        "en": "How often each camera image is sent to Gladys. An alarm or a new event also sends one at once.",
        "fr": "Fréquence d'envoi de l'image de chaque caméra à Gladys. Une alarme ou un nouvel événement en envoie aussi une aussitôt.",
        "de": "Wie oft das Bild jeder Kamera an Gladys gesendet wird. Ein Alarm oder neues Ereignis sendet sofort eines.",
        "es": "Con qué frecuencia se envía la imagen de cada cámara a Gladys. Una alarma o un evento nuevo también envía una al instante."
      },
      "required": false,
      "default": "60",
      "options": [
        {
          "value": "10",
          "label": {
            "en": "10 seconds",
            "fr": "10 secondes",
            "de": "10 Sekunden",
            "es": "10 segundos"
          }
        },
        {
          "value": "30",
          "label": {
            "en": "30 seconds",
            "fr": "30 secondes",
            "de": "30 Sekunden",
            "es": "30 segundos"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 minute",
            "fr": "1 minute",
            "de": "1 Minute",
            "es": "1 minuto"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes",
            "fr": "5 minutes",
            "de": "5 Minuten",
            "es": "5 minutos"
          }
        },
        {
          "value": "900",
          "label": {
            "en": "15 minutes",
            "fr": "15 minutes",
            "de": "15 Minuten",
            "es": "15 minutos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": {
        "en": "Language of the names",
        "fr": "Langue des noms",
        "de": "Sprache der Namen",
        "es": "Idioma de los nombres"
      },
      "description": {
        "en": "Names given to the features when a camera is added (Alarm, Mode…).",
        "fr": "Noms donnés aux fonctionnalités à l'ajout d'une caméra (Alarme, Mode…).",
        "de": "Namen, die den Funktionen beim Hinzufügen einer Kamera gegeben werden (Alarm, Modus…).",
        "es": "Nombres dados a las funciones al añadir una cámara (Alarma, Modo…)."
      },
      "required": false,
      "default": "fr",
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "check",
      "label": {
        "en": "Check the connection",
        "fr": "Vérifier la connexion",
        "de": "Verbindung prüfen",
        "es": "Comprobar la conexión"
      },
      "description": {
        "en": "Reads ZoneMinder again and lists its monitors, whether they receive images and their mode.",
        "fr": "Relit ZoneMinder et liste ses moniteurs, s’ils reçoivent des images et leur mode.",
        "de": "Liest ZoneMinder erneut und listet seine Monitore auf, ob sie Bilder empfangen und ihren Modus.",
        "es": "Vuelve a leer ZoneMinder y enumera sus monitores, si reciben imágenes y su modo."
      },
      "timeout_seconds": 60
    }
  ],
  "scene_triggers": [
    {
      "key": "event_started",
      "label": {
        "en": "ZoneMinder: new event",
        "fr": "ZoneMinder : nouvel événement",
        "de": "ZoneMinder: neues Ereignis",
        "es": "ZoneMinder: nuevo evento"
      },
      "description": {
        "en": "ZoneMinder starts recording an event (motion, forced alarm, continuous segment…). The image is sent to Gladys at once.",
        "fr": "ZoneMinder commence à enregistrer un événement (mouvement, alarme forcée, segment continu…). L’image est envoyée aussitôt à Gladys.",
        "de": "ZoneMinder beginnt ein Ereignis aufzuzeichnen (Bewegung, erzwungener Alarm, Daueraufnahme…). Das Bild wird sofort an Gladys gesendet.",
        "es": "ZoneMinder empieza a grabar un evento (movimiento, alarma forzada, segmento continuo…). La imagen se envía al instante a Gladys."
      },
      "fields": [
        {
          "key": "camera",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Camera",
            "fr": "Caméra",
            "de": "Kamera",
            "es": "Cámara"
          },
          "required": false,
          "description": {
            "en": "Leave empty for every camera.",
            "fr": "Laisser vide pour toutes les caméras.",
            "de": "Leer lassen für alle Kameras.",
            "es": "Déjelo vacío para todas las cámaras."
          }
        },
        {
          "key": "kind",
          "type": "select",
          "label": {
            "en": "Kind of event",
            "fr": "Type d'événement",
            "de": "Art des Ereignisses",
            "es": "Tipo de evento"
          },
          "required": false,
          "description": {
            "en": "Leave empty for every kind.",
            "fr": "Laisser vide pour tous les types.",
            "de": "Leer lassen für alle Arten.",
            "es": "Déjelo vacío para todos los tipos."
          },
          "options": [
            {
              "value": "motion",
              "label": {
                "en": "Motion",
                "fr": "Mouvement",
                "de": "Bewegung",
                "es": "Movimiento"
              }
            },
            {
              "value": "forced",
              "label": {
                "en": "Forced alarm",
                "fr": "Alarme forcée",
                "de": "Erzwungener Alarm",
                "es": "Alarma forzada"
              }
            },
            {
              "value": "continuous",
              "label": {
                "en": "Continuous recording",
                "fr": "Enregistrement continu",
                "de": "Daueraufnahme",
                "es": "Grabación continua"
              }
            },
            {
              "value": "signal",
              "label": {
                "en": "Signal lost",
                "fr": "Perte de signal",
                "de": "Signalverlust",
                "es": "Pérdida de señal"
              }
            },
            {
              "value": "linked",
              "label": {
                "en": "Linked monitor",
                "fr": "Moniteur lié",
                "de": "Verknüpfter Monitor",
                "es": "Monitor vinculado"
              }
            },
            {
              "value": "other",
              "label": {
                "en": "Other",
                "fr": "Autre",
                "de": "Andere",
                "es": "Otro"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "camera_name",
          "type": "string",
          "label": {
            "en": "Camera name",
            "fr": "Nom de la caméra",
            "de": "Kameraname",
            "es": "Nombre de la cámara"
          }
        },
        {
          "key": "kind",
          "type": "string",
          "label": {
            "en": "Kind of event",
            "fr": "Type d'événement",
            "de": "Art des Ereignisses",
            "es": "Tipo de evento"
          }
        },
        {
          "key": "cause",
          "type": "string",
          "label": {
            "en": "Cause",
            "fr": "Cause",
            "de": "Ursache",
            "es": "Causa"
          }
        },
        {
          "key": "score",
          "type": "number",
          "label": {
            "en": "Score",
            "fr": "Score",
            "de": "Punktzahl",
            "es": "Puntuación"
          }
        },
        {
          "key": "event_id",
          "type": "number",
          "label": {
            "en": "Event number",
            "fr": "Numéro de l'événement",
            "de": "Ereignisnummer",
            "es": "Número del evento"
          }
        }
      ]
    },
    {
      "key": "monitor_offline",
      "label": {
        "en": "ZoneMinder: camera offline",
        "fr": "ZoneMinder : caméra hors ligne",
        "de": "ZoneMinder: Kamera offline",
        "es": "ZoneMinder: cámara sin conexión"
      },
      "description": {
        "en": "A monitor stops receiving images from its camera (checked every minute), or ZoneMinder itself stops answering.",
        "fr": "Un moniteur ne reçoit plus d’images de sa caméra (vérifié chaque minute), ou ZoneMinder lui-même ne répond plus.",
        "de": "Ein Monitor bekommt keine Bilder mehr von seiner Kamera (jede Minute geprüft), oder ZoneMinder selbst antwortet nicht mehr.",
        "es": "Un monitor deja de recibir imágenes de su cámara (comprobado cada minuto), o el propio ZoneMinder deja de responder."
      },
      "fields": [
        {
          "key": "camera",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Camera",
            "fr": "Caméra",
            "de": "Kamera",
            "es": "Cámara"
          },
          "required": false,
          "description": {
            "en": "Leave empty for every camera.",
            "fr": "Laisser vide pour toutes les caméras.",
            "de": "Leer lassen für alle Kameras.",
            "es": "Déjelo vacío para todas las cámaras."
          }
        }
      ],
      "variables": [
        {
          "key": "camera_name",
          "type": "string",
          "label": {
            "en": "Camera name",
            "fr": "Nom de la caméra",
            "de": "Kameraname",
            "es": "Nombre de la cámara"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "set_mode",
      "label": {
        "en": "ZoneMinder: change the mode",
        "fr": "ZoneMinder : changer le mode",
        "de": "ZoneMinder: Modus ändern",
        "es": "ZoneMinder: cambiar el modo"
      },
      "description": {
        "en": "Sets the mode of one monitor or all of them (e.g. Modect when the alarm is armed). Each changed monitor restarts for a few seconds.",
        "fr": "Règle le mode d’un moniteur ou de tous (ex. Modect quand l’alarme est armée). Chaque moniteur modifié redémarre quelques secondes.",
        "de": "Stellt den Modus eines Monitors oder aller ein (z. B. Modect bei scharfer Alarmanlage). Jeder geänderte Monitor startet einige Sekunden neu.",
        "es": "Ajusta el modo de un monitor o de todos (p. ej. Modect con la alarma armada). Cada monitor modificado se reinicia unos segundos."
      },
      "timeout_seconds": 60,
      "fields": [
        {
          "key": "camera",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Camera",
            "fr": "Caméra",
            "de": "Kamera",
            "es": "Cámara"
          },
          "required": false,
          "description": {
            "en": "Leave empty for every camera.",
            "fr": "Laisser vide pour toutes les caméras.",
            "de": "Leer lassen für alle Kameras.",
            "es": "Déjelo vacío para todas las cámaras."
          }
        },
        {
          "key": "mode",
          "type": "select",
          "label": {
            "en": "Mode",
            "fr": "Mode",
            "de": "Modus",
            "es": "Modo"
          },
          "required": true,
          "options": [
            {
              "value": "monitor",
              "label": {
                "en": "Monitor (watch only)",
                "fr": "Monitor (visualisation seule)",
                "de": "Monitor (nur ansehen)",
                "es": "Monitor (solo visualizar)"
              }
            },
            {
              "value": "modect",
              "label": {
                "en": "Modect (record on motion)",
                "fr": "Modect (enregistre sur mouvement)",
                "de": "Modect (Aufnahme bei Bewegung)",
                "es": "Modect (graba con movimiento)"
              }
            },
            {
              "value": "record",
              "label": {
                "en": "Record (always)",
                "fr": "Record (enregistre en continu)",
                "de": "Record (Daueraufnahme)",
                "es": "Record (graba siempre)"
              }
            },
            {
              "value": "mocord",
              "label": {
                "en": "Mocord (always, motion marked)",
                "fr": "Mocord (continu, mouvement marqué)",
                "de": "Mocord (Dauer, Bewegung markiert)",
                "es": "Mocord (siempre, movimiento marcado)"
              }
            },
            {
              "value": "nodect",
              "label": {
                "en": "Nodect (external trigger)",
                "fr": "Nodect (déclenchement externe)",
                "de": "Nodect (externer Auslöser)",
                "es": "Nodect (disparo externo)"
              }
            }
          ]
        }
      ],
      "outputs": [
        {
          "key": "cameras",
          "type": "number",
          "label": {
            "en": "Cameras changed",
            "fr": "Caméras modifiées",
            "de": "Geänderte Kameras",
            "es": "Cámaras modificadas"
          }
        }
      ]
    },
    {
      "key": "force_alarm",
      "label": {
        "en": "ZoneMinder: forced alarm",
        "fr": "ZoneMinder : alarme forcée",
        "de": "ZoneMinder: erzwungener Alarm",
        "es": "ZoneMinder: alarma forzada"
      },
      "description": {
        "en": "Starts a forced alarm (ZoneMinder records an event until it is cancelled), or cancels it. Modect, Mocord or Nodect only.",
        "fr": "Déclenche une alarme forcée (ZoneMinder enregistre un événement jusqu’à son annulation), ou l’annule. Modect, Mocord ou Nodect seulement.",
        "de": "Löst einen erzwungenen Alarm aus (ZoneMinder zeichnet ein Ereignis auf, bis er beendet wird) oder beendet ihn. Nur Modect, Mocord oder Nodect.",
        "es": "Activa una alarma forzada (ZoneMinder graba un evento hasta que se cancela), o la cancela. Solo Modect, Mocord o Nodect."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "camera",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Camera",
            "fr": "Caméra",
            "de": "Kamera",
            "es": "Cámara"
          },
          "required": true
        },
        {
          "key": "command",
          "type": "select",
          "label": {
            "en": "Command",
            "fr": "Commande",
            "de": "Befehl",
            "es": "Orden"
          },
          "required": true,
          "options": [
            {
              "value": "start",
              "label": {
                "en": "Start",
                "fr": "Déclencher",
                "de": "Auslösen",
                "es": "Activar"
              }
            },
            {
              "value": "cancel",
              "label": {
                "en": "Cancel",
                "fr": "Annuler",
                "de": "Beenden",
                "es": "Cancelar"
              }
            }
          ]
        }
      ]
    },
    {
      "key": "get_status",
      "label": {
        "en": "ZoneMinder: read a camera",
        "fr": "ZoneMinder : lire une caméra",
        "de": "ZoneMinder: Kamera abfragen",
        "es": "ZoneMinder: leer una cámara"
      },
      "description": {
        "en": "Reads a monitor now: whether it receives images, is in alarm, captures, its mode and today’s events.",
        "fr": "Lit un moniteur maintenant : s’il reçoit des images, s’il est en alarme, s’il capture, son mode et les événements du jour.",
        "de": "Liest einen Monitor jetzt: ob er Bilder empfängt, im Alarm ist, aufnimmt, seinen Modus und die heutigen Ereignisse.",
        "es": "Lee un monitor ahora: si recibe imágenes, está en alarma, captura, su modo y los eventos de hoy."
      },
      "timeout_seconds": 30,
      "fields": [
        {
          "key": "camera",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Camera",
            "fr": "Caméra",
            "de": "Kamera",
            "es": "Cámara"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "online",
          "type": "boolean",
          "label": {
            "en": "Receives images",
            "fr": "Reçoit des images",
            "de": "Empfängt Bilder",
            "es": "Recibe imágenes"
          }
        },
        {
          "key": "alarm",
          "type": "boolean",
          "label": {
            "en": "In alarm",
            "fr": "En alarme",
            "de": "Im Alarm",
            "es": "En alarma"
          }
        },
        {
          "key": "enabled",
          "type": "boolean",
          "label": {
            "en": "Capture on",
            "fr": "Capture active",
            "de": "Aufnahme aktiv",
            "es": "Captura activa"
          }
        },
        {
          "key": "mode",
